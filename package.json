{
  "name": "opentype",
  "productName": "OpenType",
  "version": "0.2.2-beta.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "支持云端与本地 SenseVoice 的语音输入法：快捷键听写，将识别文字写入当前应用",
  "main": "dist/main/index.js",
  "scripts": {
    "native": "node scripts/build-native.mjs",
    "build:main": "tsup",
    "build:renderer": "vite build",
    "build": "npm run native && npm run build:main && npm run build:renderer",
    "dev": "concurrently \"tsup --watch\" \"vite\"",
    "start": "node scripts/start-electron.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "npm run test:core && npm run test:privacy && npm run test:shortcut && npm run test:auth && npm run test:providers && npm run test:db && npm run test:contract && npm run test:sync && npm run test:renderer-voice && npm run test:secure-store && npm run test:ipc-voice && npm run test:frontend-runtime && npm run test:refinement && npm run test:local-asr && npm run test:capture-session && npm run test:shortcut-capture && npm run test:live-transcription && npm run test:history-lifecycle && npm run test:recording-controls && npm run test:network-policy && npm run test:output-preferences && npm run test:correction-learning && npm run test:input-delivery && npm run test:answer-card && npm run test:input-corrections && npm run test:audio-storage && npm run test:model-store",
    "test:renderer-voice": "esbuild scripts/test-renderer-voice.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-renderer-voice.mjs --external:better-sqlite3 --external:drizzle-orm --external:undici --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-renderer-voice.mjs",
    "test:sync": "esbuild scripts/test-sync.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-sync.mjs --external:better-sqlite3 --external:drizzle-orm --external:undici --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-sync.mjs",
    "test:native": "node scripts/smoke-native.mjs",
    "typecheck": "tsc --noEmit",
    "test:core": "esbuild scripts/test-core.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-core.mjs --log-level=warning && node node_modules/.cache/test-core.mjs",
    "test:db": "esbuild scripts/test-db.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-db.mjs --external:better-sqlite3 --external:drizzle-orm --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-db.mjs",
    "verify": "npm run typecheck && npm run test && npm run test:native && npm run test:pasteboard && npm run gateway:build && npm run test:gateway && npm run test:e2e && npm run test:desktop:host && npm run test:keyboard:host && npm run test:input-target:native",
    "rebuild:native": "electron-builder install-app-deps",
    "test:privacy": "esbuild scripts/test-privacy.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-privacy.mjs --log-level=warning && node node_modules/.cache/test-privacy.mjs",
    "test:shortcut": "esbuild scripts/test-shortcut.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-shortcut.mjs --log-level=warning && node node_modules/.cache/test-shortcut.mjs",
    "test:auth": "esbuild scripts/test-auth.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-auth.mjs --external:undici --log-level=warning && node node_modules/.cache/test-auth.mjs",
    "test:e2e": "ELECTRON_RUN_AS_NODE=1 electron e2e/main.js",
    "test:providers": "esbuild scripts/test-providers.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-providers.mjs --external:undici --log-level=warning && node node_modules/.cache/test-providers.mjs",
    "gateway:build": "cd gateway && npx esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:undici --log-level=warning",
    "test:gateway": "cd gateway && node test/gateway.test.mjs",
    "test:integration": "node scripts/test-integration-local.mjs",
    "verify:all": "npm run verify && npm run test:integration && npm run test:server && npm run test:cloud-deletion && npm run test:server-network && npm run test:cloud-lifecycle",
    "test:server": "node server/test/api.test.mjs",
    "pack": "node scripts/package.mjs",
    "test:contract": "esbuild scripts/test-contract.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-contract.mjs --log-level=warning && node node_modules/.cache/test-contract.mjs",
    "build:frontend-compat": "node scripts/build-frontend-compat.mjs",
    "test:secure-store": "esbuild scripts/test-secure-store.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-secure-store.mjs --log-level=warning && node node_modules/.cache/test-secure-store.mjs",
    "test:ipc-voice": "npm run build:frontend-compat && node --test scripts/test-ipc-voice-transport.mjs",
    "test:pasteboard": "swiftc native/input-helper/PasteboardRestorer.swift scripts/test-pasteboard.swift -o node_modules/.cache/test-pasteboard && node_modules/.cache/test-pasteboard",
    "test:secure-store:host": "esbuild scripts/test-secure-store-electron.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test-secure-store-electron.cjs --external:electron --external:electron-store --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/test-secure-store-electron.cjs",
    "test:frontend-runtime": "npm run build:frontend-compat && node --test scripts/test-frontend-runtime.mjs",
    "test:refinement": "esbuild scripts/test-refinement.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-refinement.mjs --external:undici --log-level=warning && node node_modules/.cache/test-refinement.mjs",
    "test:local-asr:host": "esbuild scripts/test-local-asr-electron.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test-local-asr-electron.cjs --external:electron --external:electron-store --external:undici --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/test-local-asr-electron.cjs",
    "test:local-asr": "esbuild scripts/test-local-asr.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-local-asr.mjs --external:ogg-opus-decoder --log-level=warning && node node_modules/.cache/test-local-asr.mjs",
    "pack:beta": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.beta.cjs --mac dmg --arm64 --publish never",
    "test:capture-session": "esbuild scripts/test-capture-session.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-capture-session.mjs --log-level=warning && node node_modules/.cache/test-capture-session.mjs",
    "test:desktop:host": "esbuild scripts/test-desktop-electron.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test-desktop-electron.cjs --external:electron --external:better-sqlite3 --external:drizzle-orm --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/test-desktop-electron.cjs",
    "test:keyboard:host": "swiftc -emit-library -D KEYBOARD_TESTING -module-name keyboardtest -framework AppKit -framework IOKit native/keyboard-helper/KeyboardHelper.swift -o node_modules/.cache/libKeyboardTest.dylib && esbuild scripts/test-keyboard-electron.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test-keyboard-electron.cjs --external:electron --external:koffi --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/test-keyboard-electron.cjs",
    "test:shortcut-capture": "esbuild scripts/test-shortcut-capture.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-shortcut-capture.mjs --log-level=warning && node node_modules/.cache/test-shortcut-capture.mjs",
    "test:live-transcription": "esbuild scripts/test-live-transcription.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-live-transcription.mjs --external:undici --log-level=warning && node node_modules/.cache/test-live-transcription.mjs",
    "test:live-transcription:host": "esbuild scripts/test-live-transcription-electron.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test-live-transcription-electron.cjs --external:electron --external:undici --external:ogg-opus-decoder --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/test-live-transcription-electron.cjs",
    "test:history-lifecycle": "esbuild scripts/test-history-lifecycle.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-history-lifecycle.mjs --external:better-sqlite3 --external:drizzle-orm --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-history-lifecycle.mjs",
    "test:recording-controls": "esbuild scripts/test-recording-controls.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-recording-controls.mjs --log-level=warning && node node_modules/.cache/test-recording-controls.mjs",
    "test:cloud-deletion": "node scripts/test-cloud-deletion.mjs",
    "test:network-policy": "esbuild scripts/test-network-policy.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-network-policy.mjs --external:undici --log-level=warning && node node_modules/.cache/test-network-policy.mjs",
    "test:server-network": "node --experimental-strip-types server/test/network.test.mjs",
    "test:output-preferences": "esbuild scripts/test-output-preferences.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-output-preferences.mjs --log-level=warning && node node_modules/.cache/test-output-preferences.mjs",
    "test:output-preferences:host": "esbuild scripts/test-output-preferences-electron.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test-output-preferences-electron.cjs --external:electron --external:undici --external:ogg-opus-decoder --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/test-output-preferences-electron.cjs",
    "test:correction-learning": "esbuild scripts/test-correction-learning.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-correction-learning.mjs --external:better-sqlite3 --external:drizzle-orm --external:undici --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-correction-learning.mjs",
    "test:input-delivery": "esbuild scripts/test-input-delivery.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-input-delivery.mjs --log-level=warning && node node_modules/.cache/test-input-delivery.mjs",
    "test:input-target:native": "swiftc native/input-helper/InputHelper.swift native/input-helper/PasteboardRestorer.swift native/input-helper/InputTarget.swift native/input-helper/TextInjector.swift native/input-helper/VocaMacCompat.swift scripts/test-input-target.swift -o node_modules/.cache/test-input-target && node_modules/.cache/test-input-target",
    "test:input-delivery:ui": "esbuild scripts/test-input-delivery-ui.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/input-delivery-ui.cjs --external:electron --external:koffi --external:better-sqlite3 --external:drizzle-orm --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/input-delivery-ui.cjs --native",
    "test:answer-card": "esbuild scripts/test-answer-card.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-answer-card.mjs --external:better-sqlite3 --external:drizzle-orm --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-answer-card.mjs",
    "test:answer-card:ui": "npm run build:main && npm run build:renderer && esbuild scripts/test-input-delivery-ui.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/input-delivery-ui.cjs --external:electron --external:koffi --external:better-sqlite3 --external:drizzle-orm --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/input-delivery-ui.cjs --answers",
    "test:input-corrections": "esbuild scripts/test-input-corrections.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-input-corrections.mjs --external:better-sqlite3 --external:drizzle-orm --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-input-corrections.mjs",
    "test:input-corrections:ui": "esbuild scripts/test-input-delivery-ui.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/input-delivery-ui.cjs --external:electron --external:koffi --external:better-sqlite3 --external:drizzle-orm --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/input-delivery-ui.cjs --learning --native",
    "test:cloud-lifecycle": "node --experimental-strip-types server/test/cloud-lifecycle.test.mjs && node scripts/test-cloud-deletion.mjs --lifecycle",
    "test:audio-storage": "esbuild scripts/test-audio-storage.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-audio-storage.mjs --external:better-sqlite3 --external:drizzle-orm --log-level=warning && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/test-audio-storage.mjs",
    "test:audio-storage:ui": "esbuild scripts/test-audio-storage-ui.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/audio-storage-ui.cjs --external:electron --external:better-sqlite3 --external:drizzle-orm --log-level=warning && env -u ELECTRON_RUN_AS_NODE electron node_modules/.cache/audio-storage-ui.cjs",
    "test:model-store": "esbuild scripts/test-model-store.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-model-store.mjs --log-level=warning && node node_modules/.cache/test-model-store.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.2",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "koffi": "^2.16.3",
    "lucide-react": "^1.54.0",
    "ogg-opus-decoder": "1.7.5",
    "sherpa-onnx-node": "^1.13.8",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
